# Public browser-safe Supabase values only.
# NEVER put a service_role or secret key in VITE_* variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Optional Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX.
VITE_GA_MEASUREMENT_ID=

# Server-only secrets used by Supabase Edge Functions (configure with `supabase secrets set`; do NOT prefix with VITE_):
# RESEND_API_KEY=
# AUTH_OTP_FROM=CodaVybes <auth@your-verified-domain.com>
# AUTH_OTP_PEPPER=
# FIREBASE_SERVICE_ACCOUNT_JSON=
# PUSH_WEBHOOK_SECRET=
