# Public browser-safe Supabase values only.
# NEVER put a service_role or secret key in VITE_* variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Build identity (web defaults are built in; CI sets Android/Windows explicitly)
VITE_APP_PLATFORM=web
VITE_APP_VERSION=13.4.0
