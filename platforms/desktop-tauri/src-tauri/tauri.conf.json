{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodaVybes",
  "version": "1.0.0",
  "identifier": "app.codavybes.desktop",
  "build": {
    "beforeDevCommand": "cd ../.. && npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "cd ../.. && npm run build",
    "frontendDist": "../../../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CodaVybes",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/512x512.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["app.codavybes.desktop", "app.vybe.desktop"]
      }
    }
  }
}
