{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VYBE",
  "version": "1.0.0",
  "identifier": "app.vybe.desktop",
  "build": {
    "beforeDevCommand": "cd ../../.. && npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "cd ../../.. && npm run build",
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VYBE",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
