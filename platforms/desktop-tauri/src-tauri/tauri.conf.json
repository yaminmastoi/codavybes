{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodaVybes",
  "version": "13.4.0",
  "identifier": "com.codabite.codavybes",
  "build": {
    "beforeDevCommand": "npm --prefix ../.. run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm --prefix ../.. run build",
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CodaVybes",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "CodaBite",
    "shortDescription": "CodaVybes social app",
    "longDescription": "CodaVybes powered by CodaBite \u2014 meet people, build bonds, play, post and earn Aura."
  }
}
