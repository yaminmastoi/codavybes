{
  "name": "codavybes-mobile-shell",
  "private": true,
  "version": "1.0.1",
  "scripts": {
    "web:build": "cd ../.. && npm run build",
    "assets": "capacitor-assets generate --assetPath assets",
    "sync": "npm run web:build && cap sync",
    "sync:android": "npm run web:build && npm run assets && cap sync android",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.5.1",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.1",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/status-bar": "8.0.3",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "latest",
    "@capacitor/cli": "8.5.1",
    "typescript": "7.0.2"
  }
}
